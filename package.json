{
  "name": "projeto-marmita-flow",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "test:api": "node --test tests/api.test.js",
    "check:api": "node scripts/check-api.mjs",
    "db:migrate:local": "wrangler d1 migrations apply marmitaflow-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply marmitaflow-db --remote",
    "deploy": "npm run build && wrangler deploy",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "vite": "^8.3.4",
    "wrangler": "^4.151.0"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "qrcode": "^1.5.4"
  }
}
